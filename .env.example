# Local browser-to-API origin. Copy this file to .env.local for a new checkout.
# Do not use 127.0.0.1 here: make local and Vite use localhost consistently.
# Database credentials, including Neon DATABASE_URL, belong only in the backend
# workspace; never add them to a VITE_* variable or a frontend env file.
VITE_API_URL=http://localhost:3000
